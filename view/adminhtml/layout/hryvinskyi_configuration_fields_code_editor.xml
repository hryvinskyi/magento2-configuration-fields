<!--
    The code editor's stylesheet, for an admin page whose form holds the editor. The page asks with
    <update handle="hryvinskyi_configuration_fields_code_editor"/> in its own layout file. The admin UI kit's
    stylesheet comes first, so the editor reads the kit's tokens; the editor's own stylesheet follows. A form rendered
    into a modal gets no head of its own, so the page that hosts the modal asks for this handle.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="hryvinskyi_admin_ui"/>
    <head>
        <css src="Hryvinskyi_ConfigurationFields::css/codemirror-editor.css"/>
    </head>
</page>
