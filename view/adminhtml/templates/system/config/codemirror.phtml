declare(strict_types=1);

use Hryvinskyi\ConfigurationFields\ViewModel\CodeMirrorField;
use Magento\Framework\Data\Form\Element\AbstractElement;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/**
 * A code field: Magento's textarea, which CodeMirror replaces once its script has mounted on the root
 *
 * The root carries the kit's `hui` class and the root class of earlier versions. The textarea's text goes through the
 * attribute escaper, which also encodes an ampersand that is already part of an entity: a stored `&lt;` reaches the
 * editor as `&lt;`, not as `<`, and is saved back unchanged.
 *
 * @var Template $block
 * @var Escaper $escaper
 */
$element = $block->getData('element');
$viewModel = $block->getData('view_model');
$editorConfig = $block->getData('editor_config');
if (!$element instanceof AbstractElement || !$viewModel instanceof CodeMirrorField || !is_array($editorConfig)) {
    return;
}
$config = $viewModel->config($element, $editorConfig);
$disabled = $config['disabled'];
?>
<div class="hui hcf-code codemirror-editor-root"
     id="<?= $escaper->escapeHtmlAttr($config['mount']['rootId']) ?>"
     data-role="hcf-code"<?= $disabled ? ' data-disabled="true"' : '' ?>>
    <textarea id="<?= $escaper->escapeHtmlAttr($config['inputId']) ?>"
              name="<?= $escaper->escapeHtmlAttr($config['inputName']) ?>"
              class="admin__control-textarea codemirror-textarea"<?= $disabled ? ' disabled' : '' ?>
    ><?= $escaper->escapeHtmlAttr($config['value']) ?></textarea>
</div>
<script type="text/x-magento-init"><?= /* @noEscape */ $config['mount']['initJson'] ?></script>
